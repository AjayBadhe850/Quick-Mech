# QuickMech Backend Environment Variables
NODE_ENV=development
PORT=5000

# PostgreSQL Connection URL (Prisma)
# Example for Railway: postgresql://postgres:password@roundhouse.proxy.rlwy.net:54321/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/quickmech

# JWT Secret for authenticating sessions
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Resend API Key for OTP transactional emails
# Get an API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=QuickMech <onboarding@resend.dev>

# Allowed Frontend Origins (Comma separated for multiple)
FRONTEND_URL=http://localhost:5173,http://localhost:3000
