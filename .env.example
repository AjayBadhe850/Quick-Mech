# QuickMech Environment Configuration

# Backend Server Port
BACKEND_PORT=5000

# Frontend API URL (for development)
REACT_APP_API_URL=http://localhost:5000

# Frontend Port (default: 3000, set by react-scripts)
PORT=3000

# Database Configuration (if using MongoDB)
# MONGODB_URI=mongodb://localhost:27017/quickmech

# Twilio Configuration (for SMS OTP in production)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# AWS Configuration (alternative to Twilio)
# AWS_ACCESS_KEY_ID=your_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1

# Firebase Configuration (alternative for OTP)
# FIREBASE_API_KEY=your_firebase_api_key
# FIREBASE_PROJECT_ID=your_project_id

# Environment Mode
NODE_ENV=development
